[Unit]
Description=Telegram Movies and Series AutoFilter Bot
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/autofilter_bot
ExecStart=/opt/autofilter_bot/venv/bin/python /opt/autofilter_bot/bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
