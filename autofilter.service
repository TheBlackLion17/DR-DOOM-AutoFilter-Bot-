[Unit]
Description=DR DOOM Telegram AutoFilter Bot
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/DR-DOOM-AutoFilter-Bot-
ExecStart=/root/DR-DOOM-AutoFilter-Bot-/venv/bin/python /root/DR-DOOM-AutoFilter-Bot-/bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
